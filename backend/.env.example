PORT=4000
# Comma-separated: patient site and staff portal
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001
# Signs demo login tokens. Set any long random string so logins survive restarts.
DEMO_SECRET=
INHAYAT_MODE=demo
# Pilot only: set DATA_DIR to an isolated absolute directory on a persistent volume.
# DATA_DIR=
# DATA_ENCRYPTION_KEY=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Set trusted proxy addresses/CIDRs only if the proxy replaces forwarding headers.
# TRUST_PROXY_CIDRS=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# GEMINI_API_KEY=
# GEMINI_MODEL=
