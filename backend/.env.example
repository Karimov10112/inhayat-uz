PORT=4000
# Comma-separated: patient site and staff portal
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001

# --- Data ---------------------------------------------------------------
# Leave both empty -> DEMO mode (data in backend/.demo-data/, demo accounts).
# Fill both -> Supabase mode (run supabase/*.sql 001..005 first).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Signs demo login tokens. Set any long random string so logins survive restarts.
DEMO_SECRET=

# --- Files --------------------------------------------------------------
# Leave empty -> files saved in backend/.demo-data/files (demo only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lifebridge-medical-files

# --- AI agent ("Nazoratchi") --------------------------------------------
# No key -> offline rule-based mode. AI_PROVIDER: anthropic | openai (auto if empty)
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Any OpenAI-compatible API (OpenAI, Azure, Groq, OpenRouter, local LLM, ...)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
